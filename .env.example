# SSV Dandiya Divas 2026 — Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ============================================================
# APPLICATION
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SSV Dandiya Divas 2026"

# ============================================================
# DATABASE
# ============================================================
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/ssv_dandiya_divas"
# Direct PostgreSQL connection string for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://postgres:password@localhost:5432/ssv_dandiya_divas"

# ============================================================
# AUTHENTICATION
# ============================================================
# Generate a strong random secret: openssl rand -base64 64
AUTH_SECRET="change-this-to-a-secure-random-string-before-production"

# Admin account (used by seed script to create initial admin)
ADMIN_EMAIL="admin@ssvgroup.in"
ADMIN_PASSWORD="ChangeThisSecurePassword123!"

# ============================================================
# PAYMENT
# ============================================================
# Set to "demo" for local testing, "razorpay" for real payments
PAYMENT_MODE=demo

# Razorpay credentials (get from https://dashboard.razorpay.com)
# NEXT_PUBLIC_ prefix makes the KEY_ID available in browser (safe)
# NEVER expose KEY_SECRET in browser
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ============================================================
# EMAIL (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
EMAIL_FROM="SSV Group <noreply@ssvgroup.in>"

# ============================================================
# GOOGLE MAPS
# ============================================================
# Set to your Google Maps URL for the venue
NEXT_PUBLIC_GOOGLE_MAPS_URL="https://maps.google.com/maps?q=Gumpa,Bidar,Karnataka,India"

# ============================================================
# WHATSAPP (OPTIONAL)
# ============================================================
# Leave blank unless you have a WhatsApp Business API provider
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# ============================================================
# SECURITY
# ============================================================
# Rate limiting (requests per window)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
